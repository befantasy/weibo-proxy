# API 鉴权 Token
AUTH_TOKEN=weibo-proxy

# 服务端口（可选，默认 3000）
PORT=3000

# Cloudflare Workers KV 配置（用于会话持久化，在 Render.com 免费版部署时必填！）
# 获取方式：https://dash.cloudflare.com/
# 注意：在 Render 部署时，请在 Render Dashboard -> Environment 中配置以下环境变量
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# 说明：
# 1. 在 Render.com 免费版上，因容器无持久化硬盘（Ephemeral Disk），重启或休眠后本地文件会被清空，必须配置 Cloudflare KV。
# 2. Account ID: 登录 Cloudflare Dashboard 后在 URL 中可以找到
# 3. Namespace ID: 在 Workers & Pages -> KV 中创建命名空间后获取
# 4. API Token: 在 My Profile -> API Tokens 中创建，需要 "Workers KV Storage:Edit" 权限
