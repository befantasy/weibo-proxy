# API 鉴权 Token
AUTH_TOKEN=weibo-proxy

# 服务端口（可选，默认 3000）
PORT=3000

# Cloudflare Workers KV 配置（用于会话持久化）
# 获取方式：https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_NAMESPACE_ID=your_namespace_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# 注意：
# 1. 如果不配置 Cloudflare KV，系统会回退到本地文件存储（容器重启后会丢失）
# 2. Account ID: 登录 Cloudflare Dashboard 后在 URL 中可以找到
# 3. Namespace ID: 在 Workers & Pages -> KV 中创建命名空间后获取
# 4. API Token: 在 My Profile -> API Tokens 中创建，需要 "Workers KV Storage:Edit" 权限
